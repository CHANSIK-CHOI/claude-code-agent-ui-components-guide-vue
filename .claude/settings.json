{
  "permissions": {
    "allow": [
      "mcp__figma",
      "mcp__plugin_figma_figma",
      "mcp__playwright",
      "mcp__context7",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Read(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(wget*)",
      "Bash(ssh*)",
      "Write(./.env)",
      "Write(./.env.*)"
    ],
    "defaultMode": "plan"
  },
  "model": "sonnet",
  "enabledMcpjsonServers": ["figma", "context7", "playwright"],
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "language": "korean",
  "skipAutoPermissionPrompt": true
}
