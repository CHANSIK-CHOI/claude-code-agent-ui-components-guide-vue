{
  "permissions": {
    "allow": [
      "mcp__figma",
      "mcp__plugin_figma_figma",
      "mcp__playwright",
      "mcp__context7",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(curl -s *)",
      "Read(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(wget*)",
      "Bash(ssh*)",
      "Write(./.env)",
      "Write(./.env.*)"
    ],
    "defaultMode": "plan"
  },
  "enabledMcpjsonServers": ["figma", "context7", "playwright"],
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "language": "korean",
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/detect-claude-changes.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/format-on-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify-docs-sync.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/typecheck.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
